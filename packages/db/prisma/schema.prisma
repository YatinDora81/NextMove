generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id         String   @id @default(uuid())
  firstName  String   @default("")
  lastName   String?  @default("")
  email      String   @unique
  password   String?  // Hashed password
  profilePic String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isPaid     Boolean  @default(false)

  // relations
  resumes           Resumes[]           @relation("UserResume")
  company           Company[]           @relation("CreatedByRelation")
  messages          Message[]           @relation("User_Message")
  Room              Room[]              @relation("Room_User")
  generatedMessages GeneratedMessages[] @relation("User_gen_rel")
  templates         Templates[]         @relation("User_Templates")
  aiTemplates       AiTemplate[]        @relation("User_AiTemplate")
  passwordResets    PasswordReset[]     @relation("User_PasswordReset")

  // JobFill (JF-001) relations
  profileBlob     ProfileBlob?     @relation("User_ProfileBlob")
  jobApplications JobApplication[] @relation("User_JobApplication")
  siteMappings    SiteMapping[]    @relation("User_SiteMapping")
  devices         Device[]         @relation("User_Device")
  geminiKeys      UserGeminiKey[]  @relation("User_GeminiKey")

  @@index([id, email])
}

model PasswordReset {
  id         String   @id @default(uuid())
  userId     String
  otp        String
  resetToken String?  // Generated after OTP verification
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user Users @relation("User_PasswordReset", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([otp])
}

model GeneratedMessages {
  id            String      @id @default(uuid())
  recruiterName String?
  role          String
  template      String
  company       String
  message       String
  gender        String?
  messageType   MessageType
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          String

  userGen         Users     @relation("User_gen_rel", fields: [user], references: [id])
  roleRel         Role      @relation("Role_GeneratedMessages", fields: [role], references: [id])
  templateRel     Templates @relation("Template_GeneratedMessages", fields: [template], references: [id])
  company_gen_rel Company   @relation("Company_GeneratedMessages", fields: [company], references: [id])

  @@index([id])
}

model Resumes {
  id        String   @id @default(uuid())
  name      String
  link      String
  userId    String
  user      Users    @relation("UserResume", fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Role {
  id   String  @id @default(uuid())
  name String
  desc String?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  company           Company[]           @relation("RolesRelation")
  templates         Templates[]         @relation("RolesRelation")
  GeneratedMessages GeneratedMessages[] @relation("Role_GeneratedMessages")
}

model Templates {
  id          String      @id @default(uuid())
  name        String
  description String?
  type        MessageType @default(MESSAGE)
  content     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  role        String
  user        String
  isDeleted   Boolean     @default(false)
  isCommon    Boolean     @default(false)
  createdBy   CreatedBy   @default(SELF)

  // relations
  roleRelation      Role                @relation("RolesRelation", fields: [role], references: [id])
  userRelation      Users               @relation("User_Templates", fields: [user], references: [id])
  rules             TemplateRules[]     @relation("TemplateRules")
  GeneratedMessages GeneratedMessages[] @relation("Template_GeneratedMessages")
}

model AiTemplate {
  id                  String   @id @default(uuid())
  message             String
  rules               String[]
  templateName        String
  templateDescription String?
  history             String[] @default([])
  prompt              String
  roleName            String
  roleNameId          String
  userId              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                Users    @relation("User_AiTemplate", fields: [userId], references: [id])

  @@index([userId])
}

model TemplateRules {
  id         String   @id @default(uuid())
  rule       String
  templateId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  templateRelation Templates @relation("TemplateRules", fields: [templateId], references: [id])
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles     Role[]   @relation("RolesRelation")

  GeneratedMessages GeneratedMessages[] @relation("Company_GeneratedMessages")
  createdByRelation Users               @relation("CreatedByRelation", fields: [createdBy], references: [id])
}

model Message {
  id        String    @id @default(uuid())
  message   String
  by        MessageBy
  userId    String
  roomId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // relations
  user      Users     @relation("User_Message", fields: [userId], references: [id])
  room      Room      @relation("Room_Messages", fields: [roomId], references: [id])
}

model Room {
  id                 String    @id @default(uuid())
  name               String
  description        String
  predefinedMessages String[]
  userId             String
  messages           Message[] @relation("Room_Messages")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user Users @relation("Room_User", fields: [userId], references: [id])
}

// ---------------------------------------------------------------------------
// JF-001 · Phase 2 sync track (SEC 7.4) — additive only, existing models untouched
// ---------------------------------------------------------------------------

model ProfileBlob {
  // E2E-encrypted vault sync — the server stores ciphertext it cannot read
  id         String   @id @default(uuid())
  userId     String   @unique
  ciphertext Bytes
  nonce      Bytes
  version    Int // optimistic concurrency — PUT with a stale version ⇒ 409
  updatedAt  DateTime @updatedAt

  user Users @relation("User_ProfileBlob", fields: [userId], references: [id], onDelete: Cascade)
}

model JobApplication {
  // extension-filled ATS applications ≠ GeneratedMessages outreach
  id        String       @id @default(uuid())
  userId    String
  clientId  String       @unique // extension row id → idempotent sync (no dupes on retry)
  company   String
  role      String
  url       String?
  urlKey    String? // `url` reduced to a stable key — see normalizeUrlKey in jobApplicationRepo
  //          (fragment + tracking params dropped, the remaining params kept and sorted, so an
  //          Indeed `?jk=` or Taleo `?job=` id still separates two postings on one host)
  ats       String?
  status    JobAppStatus @default(APPLIED)
  appliedAt DateTime?
  notes     String?
  fillStats Json? // { filled, total } from FillReport
  history   Json? // [{ at, to }] status transitions
  updatedAt DateTime     @updatedAt

  user Users @relation("User_JobApplication", fields: [userId], references: [id], onDelete: Cascade)

  // `clientId` is a *local* extension row id, so a reinstall or a second local profile mints a new
  // one for a posting already synced and the Applied page grows a second card. This is the server's
  // own "same posting, same user" identity.
  //
  // ⚠ KNOWN DIVERGENCE from the database. The migration
  // (20260811000001_job_application_url_dedupe) creates this index as a PARTIAL one,
  // `WHERE "urlKey" IS NOT NULL`, so rows the extension could not attribute to a url stay out of
  // the index entirely. Prisma's schema language cannot express a predicate, so this line — a
  // total unique index — is the closest it can declare, and `prisma migrate dev` / `migrate diff`
  // will therefore report drift and offer to recreate the index without the predicate. Do not
  // accept that offer: read the ⚠ block at the bottom of that migration.sql first. Production and
  // CI run `prisma migrate deploy`, which applies migration files and never diffs, so the
  // deployed index is the partial one regardless of what this line says.
  @@unique([userId, urlKey])
  @@index([userId, status, appliedAt])
}

model SiteMapping {
  // learn-from-correction (F-13) memory roams with the user
  userId      String
  domain      String
  sigHash     String
  profilePath String
  updatedAt   DateTime @updatedAt

  user Users @relation("User_SiteMapping", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, domain, sigHash])
}

model Device {
  // paired extension installs (SEC 8.2)
  id        String    @id @default(uuid())
  userId    String
  name      String? // "Chrome · work laptop"
  lastSeen  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user Users @relation("User_Device", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// JF-001 · Web BYOK track (SEC 15.3) — server-side envelope-sealed Gemini keys
// ---------------------------------------------------------------------------

model UserGeminiKey {
  id            String      @id @default(uuid())
  userId        String
  label         String // "personal", "second account"
  ciphertext    Bytes // AES-256-GCM output
  iv            Bytes // 12-byte random nonce, unique per encryption
  authTag       Bytes // GCM authentication tag (tamper evidence)
  keyVersion    Int         @default(1) // which master key sealed it → rotation without downtime
  last4         String // display only — the list UI never touches ciphertext
  status        AiKeyStatus @default(ACTIVE)
  strikes       Int         @default(0) // durable rotation state (429 backoff tier)
  cooldownUntil DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user Users @relation("User_GeminiKey", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum MessageBy {
  AI
  SELF
}

enum MessageType {
  EMAIL
  MESSAGE
}

enum CreatedBy {
  AI
  SELF
}

enum JobAppStatus {
  DRAFT
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  GHOSTED
}

enum AiKeyStatus {
  ACTIVE
  COOLDOWN
  EXHAUSTED
  DEAD
}
