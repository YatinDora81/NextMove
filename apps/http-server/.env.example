# ==============================================================================================
# NextMove API (apps/http-server) — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is not — never put a real secret
# here. Every value below is read either at boot (see `src/index.ts` guards) or on first use.
#
# Secrets are DELIBERATELY SEPARATE from one another (JF-001 SEC 15.8):
#   KEY_VAULT_MASTER_KEY  !=  JWT_SECRET  !=  INTERNAL_API_SECRET  !=  ADMIN_SECRET
# Rotating any one of them must never require touching the others. Do not reuse a value.
# ==============================================================================================


# ----------------------------------------------------------------------------------------------
# 1. Runtime
# ----------------------------------------------------------------------------------------------

# Port the Express server listens on.
PORT=8080

# Optional. Number of reverse proxies in front of this server, e.g. `1` behind a single load
# balancer or `2` behind CDN + LB. Leave UNSET when the server is directly exposed: enabling it
# then lets any client forge `X-Forwarded-For` and bypass the per-IP rate limiter on
# `POST /api/devices/pair` (SEC 8.4). Accepts a hop count, `true`, or an Express trust-proxy
# string such as `loopback`.
# TRUST_PROXY=1


# ----------------------------------------------------------------------------------------------
# 2. Database — Postgres via Prisma (@repo/db)
# ----------------------------------------------------------------------------------------------

# Full connection string. Also read by `packages/db` for `prisma migrate` / `prisma generate`.
DATABASE_URL=postgresql://user:password@localhost:5432/nextmove?schema=public


# ----------------------------------------------------------------------------------------------
# 3. Auth
# ----------------------------------------------------------------------------------------------

# HMAC secret for the app's own 7-day JWTs (`controllers/authControllers.ts`, and the
# device-bound pairing token minted by `controllers/deviceControllers.ts`, SEC 8.2).
# Generate with:  openssl rand -base64 48
# MUST NOT equal KEY_VAULT_MASTER_KEY — the server refuses to boot if it does (SEC 15.8).
JWT_SECRET=

# Shared secret for server-to-server calls from apps/web to this API.
# Generate with:  openssl rand -base64 32
INTERNAL_API_SECRET=

# Elevation secret + the accounts allowed to use it (comma-separated emails).
ADMIN_SECRET=
ADMIN_EMAILS=owner@example.com,ops@example.com


# ----------------------------------------------------------------------------------------------
# 4. CORS — the browser + extension allowlist
# ----------------------------------------------------------------------------------------------

# Comma-separated list (a JSON array is also accepted). Matched EXACTLY: no wildcards, no prefix
# matching. Trailing slashes and casing are normalised away.
#
# JF-001 SEC 8.2 / SEC 10 — the extension's own origin goes in this list:
#
#     ORIGINS=https://nextmove-yatin.vercel.app,chrome-extension://abcdefghijklmnopabcdefghijklmnop
#
# That single entry is why Phase-2 sync ships with ZERO new manifest permissions — the extension
# is allowlisted server-side rather than granted host permissions client-side. A chrome extension
# id is exactly 32 characters from a–p; malformed entries are warned about at boot.
ORIGINS=http://localhost:3000,https://nextmove-yatin.vercel.app


# ----------------------------------------------------------------------------------------------
# 5. Redis (pair codes, rate-limit buckets, rotation ledgers, response cache)
#
# All Redis access goes through the fail-safe helpers in `src/utils/redisCommon.ts`: an outage
# degrades features (no cache, no rate limiting, DB-only rotation checks) instead of failing
# requests. The server starts and serves normally with Redis down.
# ----------------------------------------------------------------------------------------------

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=


# ----------------------------------------------------------------------------------------------
# 6. Gemini — the MANAGED key lane (lane 3: premium web users)
#
# JF-001 SEC 15.1: this key is owner-paid and serves apps/web features only. The browser extension
# NEVER routes AI through this server (INV-6) — extension users bring their own on-device keys.
# ----------------------------------------------------------------------------------------------

# Single-key form.
GEMINI_API_KEY=

# Optional pool form: a JSON array of the *names* of other env vars that hold keys. The managed
# lane round-robins across all of them, so several owner keys multiply the managed quota.
# A malformed value is logged and ignored — it never takes the API offline.
# GEMINI_API_KEY_NAMES=["GEMINI_API_KEY_Y81","GEMINI_API_KEY_YPT"]
# GEMINI_API_KEY_Y81=
# GEMINI_API_KEY_YPT=

# Optional. Override the free-tier rotation budgets used by the BYOK lane
# (`services/rotationStore.service.ts`). These limits are APPROXIMATE — Google revises free-tier
# quotas without notice — so they are soft ceilings, overridable without a code deploy.
# WEB_MODEL_BUDGETS={"gemini-2.5-flash-lite":{"rpm":15,"rpd":1000},"gemini-2.5-flash":{"rpm":10,"rpd":250},"gemini-2.0-flash":{"rpm":15,"rpd":200}}


# ----------------------------------------------------------------------------------------------
# 7. Web BYOK vault (lane 2: free-tier web users)  —  JF-001 SEC 15
#
# REQUIRED. The server refuses to boot without a valid KEY_VAULT_MASTER_KEY.
# ----------------------------------------------------------------------------------------------

# Master key for AES-256-GCM envelope encryption of user-supplied Gemini keys
# (`UserGeminiKey.ciphertext`). 32 raw bytes, base64-encoded.
#
#     openssl rand -base64 32
#
# HARD RULES (SEC 15.8):
#   · It MUST be a DIFFERENT value from JWT_SECRET. The boot sequence compares them and throws if
#     they match — a leaked signing secret must never also unseal every stored user key.
#   · It lives OUTSIDE the database. A stolen DB dump alone decrypts nothing.
#   · A base64 value that decodes to anything other than 32 bytes is rejected at boot — truncated
#     or line-wrapped secrets decode short and would silently weaken every sealed key.
#
# ROTATION: add KEY_VAULT_MASTER_KEY_V2, uncomment the version-2 slot in `src/utils/keyVault.ts`
# and bump CURRENT. Existing rows keep opening under their stored `keyVersion` and re-seal lazily
# on next use — no downtime, no bulk migration.
KEY_VAULT_MASTER_KEY=

# Rotation slot — only set this when performing a master-key rotation.
# KEY_VAULT_MASTER_KEY_V2=

# Feature flag, SEC 15.7 rollout.
#   false (default) → a free user with no vault key falls back to the managed key.
#                     This is the 30-day GRANDFATHER WINDOW: ship the vault + UI, show the
#                     "web AI is moving to your own free Google key" banner, break nothing.
#   true            → a free user with no vault key gets 402 AI_SETUP_REQUIRED and the frontend
#                     deep-links them to Settings → AI Keys. Premium is unaffected either way.
WEB_BYOK_REQUIRED=false


# ----------------------------------------------------------------------------------------------
# 8. Clerk (legacy webhook path — `/api/webhooks`, mounted before CORS for raw-body signature
#    verification)
# ----------------------------------------------------------------------------------------------

CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=


# ----------------------------------------------------------------------------------------------
# 9. Mail (OTP / password reset)
# ----------------------------------------------------------------------------------------------

MAIL_HOST=smtp.example.com
MAIL_USER=
MAIL_PASS=


# ----------------------------------------------------------------------------------------------
# 10. Frontend
# ----------------------------------------------------------------------------------------------

# Public origin of apps/web — used for links in transactional email.
NEXTJS_URL=http://localhost:3000
