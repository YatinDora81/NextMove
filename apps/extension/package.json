{
  "name": "extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NextMove Autofill \u2014 JobFill (JF-001) MV3 extension. Local-first job-application autofill with BYOK Gemini.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check-types": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "postinstall": "wxt prepare",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@repo/rotation": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/vault": "workspace:*",
    "dexie": "^4.4.4",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^9.34.0",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.1.13",
    "typescript": "5.9.2",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  }
