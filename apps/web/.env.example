# ==============================================================================================
# NextMove web (apps/web) — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is not — never put a real secret
# here.
#
# Anything prefixed NEXT_PUBLIC_ is INLINED INTO THE CLIENT BUNDLE at build time and is readable
# by anyone who loads the page. Never put a secret behind that prefix.
# ==============================================================================================


# ----------------------------------------------------------------------------------------------
# 1. Public — inlined into the browser bundle
# ----------------------------------------------------------------------------------------------

# Origin of the Express API (apps/http-server). Every URL in `utils/url.ts` is built from it.
# Falls back to http://localhost:8080 (the server's default PORT) when unset.
NEXT_PUBLIC_BASE_URL=http://localhost:8080

# Chrome extension id, used by `lib/extensionBridge.ts` to open a runtime port to the extension
# and by the onboarding connect step. Unset means "extension pairing disabled".
NEXT_PUBLIC_EXTENSION_ID=

# Optional. Chrome Web Store listing to link to from /extension. Defaults to a store search for
# the published listing name; override to point a staging build at an unlisted item.
NEXT_PUBLIC_CHROME_STORE_URL=https://chromewebstore.google.com/search/NextMove%20Autofill


# ----------------------------------------------------------------------------------------------
# 2. Server-only — never exposed to the browser
# ----------------------------------------------------------------------------------------------

# Shared secret for server-to-server calls into apps/http-server. Must match the server's
# INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET=

# SMTP credentials used by the server-side mail helper.
MAIL_USER=
MAIL_PASS=
